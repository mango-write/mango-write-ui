page,
.mw-mp-root {
  --mw-mp-safe-top: var(--mp-safe-top);
  --mw-mp-safe-bottom: var(--mp-safe-bottom);
  --mw-mp-keyboard-offset: var(--space-0);
  --mw-mp-capsule-width: var(--mp-capsule-w);
  background-color: var(--bg-canvas);
  color: var(--text-primary);
  font-family: var(--font-sans);
  font-size: var(--mp-type-body-size);
  line-height: var(--mp-type-body-line);
  box-sizing: border-box;
  -webkit-tap-highlight-color: transparent;
}

.mw-mp-root {
  box-sizing: border-box;
}

.mw-mp-root view,
.mw-mp-root text,
.mw-mp-root image,
.mw-mp-root button,
.mw-mp-root label,
.mw-mp-root input,
.mw-mp-root textarea,
.mw-mp-root navigator,
.mw-mp-root scroll-view,
.mw-mp-root swiper,
.mw-mp-root swiper-item,
.mw-mp-root picker,
.mw-mp-root form,
.mw-mp-root switch,
.mw-mp-root slider,
.mw-mp-root rich-text,
.mw-mp-root progress,
.mw-mp-root checkbox,
.mw-mp-root radio,
.mw-mp-root canvas,
.mw-mp-root cover-view,
.mw-mp-root cover-image {
  box-sizing: border-box;
}

.mw-mp-root button::after {
  border: 0;
  content: none;
}

.mw-mp-root .mw-size-sm,
.mw-mp-btn.mw-size-sm {
  --control-h: var(--mp-size-sm-h);
  --control-font: var(--mp-size-sm-font);
  --control-icon: var(--mp-size-sm-icon);
  --control-px: var(--mp-size-sm-px);
  --control-gap: var(--mp-size-sm-gap);
  --control-radius: var(--mp-size-sm-radius);
}

.mw-mp-root .mw-size-md,
.mw-mp-btn.mw-size-md {
  --control-h: var(--mp-size-md-h);
  --control-font: var(--mp-size-md-font);
  --control-icon: var(--mp-size-md-icon);
  --control-px: var(--mp-size-md-px);
  --control-gap: var(--mp-size-md-gap);
  --control-radius: var(--mp-size-md-radius);
}

.mw-mp-root .mw-size-lg,
.mw-mp-btn.mw-size-lg {
  --control-h: var(--mp-size-lg-h);
  --control-font: var(--mp-size-lg-font);
  --control-icon: var(--mp-size-lg-icon);
  --control-px: var(--mp-size-lg-px);
  --control-gap: var(--mp-size-lg-gap);
  --control-radius: var(--mp-size-lg-radius);
}

.mw-mp-root .mw-tabular {
  font-variant-numeric: tabular-nums;
}

.mw-mp-root .mw-frost {
  background-color: var(--frost-bg);
  background-image: var(--frost-specular);
  backdrop-filter: var(--frost-blur);
  -webkit-backdrop-filter: var(--frost-blur);
  border: var(--border-width) solid var(--frost-border);
  box-shadow: var(--frost-highlight), var(--shadow-floating);
  color: var(--text-primary);
}

.mw-mp-root .mw-frost--thick {
  background-color: var(--frost-bg-thick);
  background-image: var(--frost-specular);
  backdrop-filter: var(--frost-blur-thick);
  -webkit-backdrop-filter: var(--frost-blur-thick);
  border: var(--border-width) solid var(--frost-border);
  box-shadow: var(--frost-highlight), var(--shadow-overlay);
  color: var(--text-primary);
}

.mw-mp-field {
  border: var(--border-width) solid var(--border-subtle);
  border-radius: var(--control-radius);
  background-color: var(--bg-sunken);
  color: var(--text-primary);
  font-family: var(--font-sans);
  font-size: var(--control-font);
  line-height: var(--mp-type-body-line);
  transition: border-color var(--duration-fast) var(--ease-standard), background-color var(--duration-fast) var(--ease-standard), box-shadow var(--duration-fast) var(--ease-standard);
}

.mw-mp-field.is-focused,
.mw-mp-field:focus-within {
  outline: none;
  border-color: var(--accent-border);
  background-color: var(--bg-raised);
  box-shadow: var(--focus-shadow);
}

.mw-mp-field.is-invalid {
  border-color: var(--danger);
  box-shadow: var(--focus-shadow-danger);
}

.mw-mp-field.is-disabled {
  background-color: var(--fill-subtle);
  color: var(--text-disabled);
  opacity: var(--opacity-disabled);
}

@media (prefers-reduced-transparency: reduce) {
  .mw-mp-root .mw-frost,
  .mw-mp-root .mw-frost--thick {
    background-color: var(--frost-fallback);
    background-image: none;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }
}

@media (prefers-reduced-motion: reduce) {
  .mw-mp-field {
    transition: none;
  }
}

.mw-mp-navbar {
  position: sticky;
  top: 0;
  z-index: var(--z-sticky);
  padding-top: var(--mw-mp-safe-top);
}

.mw-mp-navbar__bar {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
  align-items: center;
  min-height: var(--mp-navbar-h);
  padding: 0 var(--space-3);
  gap: var(--space-2);
}

.mw-mp-navbar--capsule-safe .mw-mp-navbar__bar {
  padding-right: var(--mw-mp-capsule-width, var(--mp-capsule-w));
}

.mw-mp-navbar__leading,
.mw-mp-navbar__trailing {
  display: flex;
  align-items: center;
  min-width: 0;
}

.mw-mp-navbar__trailing {
  justify-content: flex-end;
}

.mw-mp-navbar__back,
.mw-mp-navbar__leading-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  min-width: var(--mp-touch-min);
  min-height: var(--mp-touch-min);
  margin: 0;
  padding: 0 var(--space-2);
  gap: var(--space-1);
  border: 0;
  border-radius: var(--radius-md);
  background: transparent;
  color: var(--text-primary);
  font-family: var(--font-sans);
  font-size: var(--mp-type-body-size);
  font-weight: var(--weight-semibold);
}

.mw-mp-navbar__leading-action {
  max-width: 100%;
}

.mw-mp-navbar__leading-action > span:first-child {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mw-mp-navbar__back {
  width: var(--mp-touch-min);
  padding: 0;
}

.mw-mp-navbar__back.is-pressed,
.mw-mp-navbar__leading-action.is-pressed {
  background-color: var(--fill-default);
}

.mw-mp-navbar__title {
  min-width: 0;
  overflow: hidden;
  color: var(--text-primary);
  font-size: var(--mp-type-title-sm-size);
  line-height: var(--mp-type-title-sm-line);
  font-weight: var(--weight-semibold);
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mw-mp-tabbar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: var(--z-sticky);
  display: grid;
  min-height: calc(var(--mp-tabbar-h) + var(--mw-mp-safe-bottom));
  padding-bottom: var(--mw-mp-safe-bottom);
  border-top: var(--border-width) solid var(--border-subtle);
}

.mw-mp-tabbar--contained {
  position: absolute;
}

.mw-mp-tabbar__item {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  min-height: var(--mp-tabbar-h);
  padding: var(--space-1) var(--space-2);
  gap: var(--space-0-5);
  border: 0;
  background: transparent;
  color: var(--mp-text-meta);
  font-family: var(--font-sans);
  font-size: var(--mp-type-micro-size);
  line-height: var(--mp-type-micro-line);
  font-weight: var(--weight-medium);
}

.mw-mp-tabbar__icon-wrap {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: var(--space-10);
  height: var(--mp-size-xs-h);
  border-radius: var(--radius-full);
}

.mw-mp-tabbar__item--active,
.mw-mp-tabbar__item.is-active {
  color: var(--text-accent);
  font-weight: var(--weight-semibold);
}

.mw-mp-tabbar__item--active .mw-mp-tabbar__icon-wrap,
.mw-mp-tabbar__item.is-active .mw-mp-tabbar__icon-wrap {
  background-color: var(--accent-subtle);
}

.mw-mp-tabbar__item.is-pressed .mw-mp-tabbar__icon-wrap {
  transform: scale(var(--mp-press-scale));
}

.mw-mp-tabbar__icon-wrap .mw-mp-badge {
  position: absolute;
  top: 0;
  right: 0;
}

.mw-mp-root--expanded .mw-mp-tabbar {
  padding-right: var(--space-12);
  padding-left: var(--space-12);
}

.mw-mp-root--landscape .mw-mp-navbar__bar {
  min-height: var(--mp-navbar-h-landscape);
}

.mw-mp-root--landscape .mw-mp-tabbar {
  min-height: calc(var(--mp-tabbar-h-landscape) + var(--mw-mp-safe-bottom));
}

.mw-mp-root--landscape .mw-mp-tabbar__item {
  flex-direction: row;
  min-height: var(--mp-tabbar-h-landscape);
  gap: var(--space-1-5);
}

.mw-mp-icon {
  display: inline-block;
  flex-shrink: 0;
  background-color: currentColor;
  -webkit-mask-image: var(--mw-mp-icon-image);
  mask-image: var(--mw-mp-icon-image);
  -webkit-mask-position: center;
  mask-position: center;
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
  -webkit-mask-size: contain;
  mask-size: contain;
}

.mw-mp-icon--spin {
  animation: mw-mp-spin var(--speed-slow) linear infinite;
}

.mw-mp-btn {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--control-gap);
  height: var(--control-h);
  min-height: var(--control-h);
  padding: 0 var(--control-px);
  border: var(--border-width) solid transparent;
  border-radius: var(--control-radius);
  font-family: var(--font-sans);
  font-size: var(--control-font);
  line-height: var(--mp-type-body-line);
  font-weight: var(--weight-semibold);
  white-space: nowrap;
  cursor: pointer;
  user-select: none;
  transition: transform var(--duration-fast) var(--ease-standard), background-color var(--duration-fast) var(--ease-standard), opacity var(--duration-fast) var(--ease-standard);
}

.mw-mp-btn--block {
  display: flex;
  width: 100%;
}

.mw-mp-btn--icon-only {
  width: var(--control-h);
  min-width: var(--control-h);
