{
  "name": "@mango-write/ui-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "build": "pnpm --filter @mango-write/ui-core build && pnpm --filter @mango-write/ui-vue build && pnpm --filter @mango-write/ui-react build && pnpm --filter @mango-write/ui-mp build",
    "prepare": "pnpm build",
    "dev": "pnpm --filter @mango-write/ui-playground dev",
    "build:playground": "pnpm --filter @mango-write/ui-playground build:playground",
    "preview:playground": "pnpm --filter @mango-write/ui-playground preview",
    "typecheck": "pnpm --filter @mango-write/ui-core typecheck && pnpm --filter @mango-write/ui-vue typecheck && pnpm --filter @mango-write/ui-react typecheck && pnpm --filter @mango-write/ui-mp typecheck && pnpm --filter @mango-write/ui-playground typecheck && pnpm --filter @mango-write/ui-react exec tsc6 --noEmit -p ../../playground/react-preview/tsconfig.json",
    "tokens:check": "node scripts/check-tokens.mjs",
    "locale:check": "node scripts/check-dev-locale.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "happy-dom": "^21.0.4",
    "jsdom": "^30.0.1",
    "lucide-vue-next": "^1.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "vue": "^3.5.34",
    "vue-i18n": "^11.4.18",
    "vue-router": "^4.4.5",
    "vue-tsc": "^3.3.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mango-write/mango-write-ui.git"
  },
  "bugs": {
    "url": "https://github.com/mango-write/mango-write-ui/issues"
  },
  "homepage": "https://github.com/mango-write/mango-write-ui#readme"
}
