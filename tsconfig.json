{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "resolveJsonModule": true,
    "paths": {
      "@mango-write/ui-core": ["./packages/core/src/index.ts"],
      "@mango-write/ui-core/*": ["./packages/core/src/*"],
      "@mango-write/ui-vue": ["./packages/vue/src/index.ts"],
      "@mango-write/ui-vue/*": ["./packages/vue/src/*"]
    }
  },
  "include": [
    "packages/core/src/**/*.ts",
    "packages/vue/src/**/*.ts",
    "packages/vue/src/**/*.vue",
    "playground/dev/**/*.ts",
    "playground/dev/**/*.vue"
  ]
}
